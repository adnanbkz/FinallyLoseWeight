# Copia este fichero a .env.local (no se sube al repo) y rellena los valores.
# Todos son públicos (acaban en el JavaScript del navegador): NO pongas aquí secretos.

# Configuración web del proyecto de Firebase (Consola de Firebase > Configuración del proyecto > Tus apps > Web).
VITE_FIREBASE_API_KEY=
# Recomendado en producción: el MISMO dominio donde se sirve la app (p. ej. tu-proyecto.web.app),
# no tu-proyecto.firebaseapp.com. Así el login con Google por redirección funciona en Safari/iOS
# y en la PWA instalada (Firebase Hosting sirve /__/auth/ en ese dominio).
# Añade también ese dominio en Authentication > Settings > Authorized domains.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Origen de la API, sin barra final y SIN /api (p. ej. https://flw-api.azurewebsites.net
# o http://localhost:5100 en desarrollo, que es el puerto de `dotnet run`).
VITE_API_BASE_URL=
